# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ── Sieve behaviour ───────────────────────────────────────────────────────────
# Minimum risk level that triggers quarantine: SAFE | SUSPICIOUS | MALICIOUS
QUARANTINE_THRESHOLD=SUSPICIOUS
# Enable the human-approval gate for MALICIOUS actions: true | false
APPROVAL_GATE_ENABLED=true
# Max characters of raw content stored per incident log entry
INCIDENT_LOG_MAX_RAW_CHARS=2000
# Quarantine audit log. AUDIT_LOG_PATH is the older name.
SIEVE_AUDIT_LOG_PATH=sieve_audit.log

# ── Dashboard / API ───────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_DEBUG=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Output format: text (human-readable) | json (structured for log aggregators)
LOG_FORMAT=text
